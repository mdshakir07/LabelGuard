{
  "ruleset": {
    "version": "PCR-2026.1",
    "label": "Packaged Commodities (Rules) 2011 — MVP seed",
    "base_notification": "Legal Metrology (Packaged Commodities) Rules, 2011 (G.S.R. 941(E))",
    "published_at": "2026-09-04",
    "review_status": "published",
    "effective_from": "2026-09-04",
    "effective_to": null,
    "source_documents": [
      "https://consumeraffairs.gov.in/pages/legal-metrology-act"
    ]
  },
  "rules": [
    {
      "rule_id": "R-APP-01",
      "rule_number": "Rule 3",
      "module": "R-APP",
      "title": "Applicability — Chapter II retail-package provisions",
      "description": "Check whether Chapter II retail-package provisions apply; package quantity/channel/consumer type determine applicability.",
      "applicability": {"always": true},
      "validation_type": "manual",
      "parameters": {"channels": ["retail", "ecommerce"], "excludes": ["industrial", "institutional"]},
      "severity": "high",
      "outcomes": {"not_retail": "not_applicable", "retail": "pass", "unknown": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 3",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-APP-02",
      "rule_number": "Definitions + Rule 3",
      "module": "R-APP",
      "title": "Retail package classification",
      "description": "Classify retail package, wholesale package, industrial/institutional package and imported package.",
      "applicability": {"always": true},
      "validation_type": "manual",
      "parameters": {},
      "severity": "medium",
      "outcomes": {"classified": "pass", "unclear": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Definitions; Rule 3",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-APP-03",
      "rule_number": "Rule 3",
      "module": "R-APP",
      "title": "Quantity threshold (25 kg / 25 L)",
      "description": "Flag packages over 25 kg or 25 litre where Chapter II exclusion may apply; special cement/fertilizer/agricultural produce treatment represented.",
      "applicability": {"field": "net_quantity", "channel": ["retail", "ecommerce"]},
      "validation_type": "comparison",
      "parameters": {
        "threshold_weight_kg": 25,
        "threshold_volume_l": 25,
        "exempt_categories": ["cement", "fertilizer", "agricultural_produce"]
      },
      "severity": "low",
      "outcomes": {"below_threshold": "pass", "above_threshold": "needs_verification", "missing_qty": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 3 (exclusion)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-APP-04",
      "rule_number": "Rule 3 + definitions",
      "module": "R-APP",
      "title": "Industrial/institutional package",
      "description": "Flag declared 'not for retail sale' context and avoid applying retail rules blindly.",
      "applicability": {"field": "not_for_retail_sale", "value": true},
      "validation_type": "presence",
      "parameters": {},
      "severity": "medium",
      "outcomes": {"present": "not_applicable", "absent": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 3; definitions",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-01",
      "rule_number": "6(1)(a)",
      "module": "R-DECL",
      "title": "Manufacturer/packer/importer name & address",
      "description": "Name and address of manufacturer, or where packed by an importer, of the packer or importer as applicable.",
      "applicability": {"retail_package": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["manufacturer_name", "packer_name", "importer_name"], "any_of": true},
      "severity": "high",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(a)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-02",
      "rule_number": "6(1)(aa)",
      "module": "R-DECL",
      "title": "Country of origin (imported)",
      "description": "Imported products must carry country of origin/manufacture/assembly as applicable.",
      "applicability": {"origin": "imported"},
      "validation_type": "required_field",
      "parameters": {"fields": ["country_of_origin"]},
      "severity": "critical",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(aa)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-03",
      "rule_number": "6(1)(b)",
      "module": "R-DECL",
      "title": "Common/generic name",
      "description": "Common or generic name of the commodity must be present.",
      "applicability": {"retail_package": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["product_name"]},
      "severity": "high",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(b)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-04",
      "rule_number": "6(1)(b)",
      "module": "R-DECL",
      "title": "Multiple products identification",
      "description": "Packages containing more than one product must identify each product and its number/quantity as applicable.",
      "applicability": {"package_structure": "multi_product"},
      "validation_type": "presence",
      "parameters": {"fields": ["product_name"]},
      "severity": "medium",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(b)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-05",
      "rule_number": "6(1)(c)",
      "module": "R-DECL",
      "title": "Net quantity",
      "description": "Net quantity by standard unit of weight/measure or by number where applicable.",
      "applicability": {"retail_package": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["net_quantity", "net_unit"]},
      "severity": "critical",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(c)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-06",
      "rule_number": "6(1)(d)",
      "module": "R-DECL",
      "title": "Manufacture/pre-packing/import date",
      "description": "Month and year as applicable, subject to exceptions and other-law provisions.",
      "applicability": {"retail_package": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["manufacture_month", "manufacture_year"]},
      "severity": "medium",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(d)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-07",
      "rule_number": "6(1)(da)",
      "module": "R-DECL",
      "title": "Best-before / use-by",
      "description": "Where commodity may become unfit after a period, relevant best-before/use-by declaration unless another law governs.",
      "applicability": {"perishable": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["best_before"]},
      "severity": "medium",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(da)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-08",
      "rule_number": "6(1)(e)",
      "module": "R-DECL",
      "title": "MRP — retail sale price inclusive of all taxes",
      "description": "Retail sale price / MRP inclusive of all taxes, in rupees/paise with prescribed rounding convention.",
      "applicability": {"retail_package": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["mrp"], "rounding_paise": 5},
      "severity": "critical",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass", "invalid": "potential_non_compliance"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(e)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-09",
      "rule_number": "6(1)(f)",
      "module": "R-DECL",
      "title": "Dimensions",
      "description": "Where sizes/dimensions are relevant, dimensions of commodity and differing pieces as applicable.",
      "applicability": {"field": "dimensions_relevant", "value": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["dimensions"]},
      "severity": "low",
      "outcomes": {"missing": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(f)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-10",
      "rule_number": "6(2)",
      "module": "R-DECL",
      "title": "Consumer contact",
      "description": "Name, address, telephone and e-mail of contact/person/office for complaints.",
      "applicability": {"retail_package": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["consumer_contact_name", "consumer_phone", "consumer_email"], "any_of": true},
      "severity": "medium",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(2)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-11",
      "rule_number": "6(3)",
      "module": "R-DECL",
      "title": "Sticker restrictions",
      "description": "Detect stickers that appear to alter mandatory declarations; reduced-MRP sticker is a special permitted case subject to conditions.",
      "applicability": {"retail_package": true},
      "validation_type": "manual",
      "parameters": {"permit_lower_mrp_sticker": true},
      "severity": "medium",
      "outcomes": {"no_sticker": "pass", "sticker_detected": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(3)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-12",
      "rule_number": "6(4A)",
      "module": "R-DECL",
      "title": "Barcode/QR/e-code presence (info only)",
      "description": "Barcode/GTIN/QR/e-code and authorized government logos may be added subject to rules.",
      "applicability": {"retail_package": true},
      "validation_type": "presence",
      "parameters": {"fields": ["barcode_gtin_qr"], "severity_low": true},
      "severity": "info",
      "outcomes": {"present": "pass", "absent": "info", "unknown": "info"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(4A)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-13",
      "rule_number": "6(5)",
      "module": "R-DECL",
      "title": "Multi-unit package declarations",
      "description": "Declarations may need to appear on main package and/or individual accompanying packages according to structure.",
      "applicability": {"package_structure": "multi_unit"},
      "validation_type": "manual",
      "parameters": {},
      "severity": "medium",
      "outcomes": {"verified": "pass", "unclear": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(5)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-14",
      "rule_number": "6(7)",
      "module": "R-DECL",
      "title": "GM food marking",
      "description": "If applicable, package may require GM marking at top of principal display panel.",
      "applicability": {"special_status": "gm_food"},
      "validation_type": "presence",
      "parameters": {"fields": ["gm_marking"]},
      "severity": "medium",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(7)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-15",
      "rule_number": "6(8)",
      "module": "R-DECL",
      "title": "Vegetarian/non-vegetarian marking",
      "description": "For specified soap, shampoo, toothpaste, cosmetics/toiletries provision, detect applicable marking and route to verification.",
      "applicability": {"category": ["cosmetics", "toiletries"]},
      "validation_type": "presence",
      "parameters": {"fields": ["veg_nonveg_marking"]},
      "severity": "low",
      "outcomes": {"missing": "needs_verification", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(8)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-DECL-16",
      "rule_number": "6(11) and amendments",
      "module": "R-DECL",
      "title": "Unit sale price",
      "description": "Where applicable, display unit sale price using prescribed unit formats.",
      "applicability": {"unit_sale_price_required": true},
      "validation_type": "required_field",
      "parameters": {"fields": ["unit_sale_price"]},
      "severity": "medium",
      "outcomes": {"missing": "potential_non_compliance", "low_confidence": "needs_verification", "present": "pass"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(11)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-READ-01",
      "rule_number": "Rule 8 + applicable provisions",
      "module": "R-READ",
      "title": "Legibility",
      "description": "Text must be readable; low-confidence/obscured declarations go to verification.",
      "applicability": {"retail_package": true},
      "validation_type": "measurement",
      "parameters": {"min_confidence": 0.6},
      "severity": "medium",
      "outcomes": {"legible": "pass", "obscured": "needs_verification", "low_confidence": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 8",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-QTY-01",
      "rule_number": "Rule 6 + units",
      "module": "R-QTY",
      "title": "Unit consistency",
      "description": "Normalize quantity and unit; detect missing/invalid/ambiguous unit.",
      "applicability": {"field": "net_quantity_present", "value": true},
      "validation_type": "pattern",
      "parameters": {"unit_dictionary": ["g", "kg", "ml", "l", "cm", "m", "nos", "pcs", "pairs", "sets"]},
      "severity": "medium",
      "outcomes": {"normalized": "pass", "ambiguous": "needs_verification", "invalid": "potential_non_compliance"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(1)(c); units",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-QTY-02",
      "rule_number": "Rule 9 / First Schedule",
      "module": "R-QTY",
      "title": "Quantity accuracy vs max permissible error",
      "description": "Where actual measured quantity is available, compare against applicable maximum permissible error schedule; otherwise do not infer actual quantity from label alone.",
      "applicability": {"measurement_available": true},
      "validation_type": "measurement",
      "parameters": {"schedule": "first_schedule"},
      "severity": "high",
      "outcomes": {"within_error": "pass", "outside_error": "potential_non_compliance", "no_measurement": "not_applicable"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 9; First Schedule",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-PRICE-01",
      "rule_number": "18(2)",
      "module": "R-PRICE",
      "title": "Sale above MRP",
      "description": "If transaction/sale evidence exists, flag sale price above declared retail sale price for officer review.",
      "applicability": {"sale_evidence_available": true},
      "validation_type": "comparison",
      "parameters": {},
      "severity": "critical",
      "outcomes": {"at_or_below": "pass", "above": "potential_non_compliance", "not_applicable": "not_applicable"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 18(2)",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-UNIT",
      "rule_number": "6(11) and amendments",
      "module": "R-UNIT",
      "title": "Unit sale price basis",
      "description": "Unit sale price must use the prescribed basis derived from net quantity (weight/length/number/volume thresholds).",
      "applicability": {"unit_sale_price_required": true},
      "validation_type": "arithmetic",
      "parameters": {
        "thresholds": {
          "weight_g": {"lt": 1000, "unit": "per_g"},
          "weight_kg": {"gte": 1000, "unit": "per_kg"},
          "length_cm": {"lt": 100, "unit": "per_cm"},
          "length_m": {"gte": 100, "unit": "per_m"},
          "volume_ml": {"lt": 1000, "unit": "per_ml"},
          "volume_l": {"gte": 1000, "unit": "per_l"},
          "number": {"always": "per_number"}
        }
      },
      "severity": "medium",
      "outcomes": {"match": "pass", "mismatch": "potential_non_compliance", "unknown": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 6(11); 2021 amendments",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-SPECIAL-02",
      "rule_number": "Rule 5 + Second Schedule",
      "module": "R-SPECIAL",
      "title": "Standard pack sizes",
      "description": "For commodities subject to standard quantities, check applicable schedule/notification; flag non-standard situations for legal verification.",
      "applicability": {"standard_quantity_applies": true},
      "validation_type": "comparison",
      "parameters": {"schedule": "second_schedule"},
      "severity": "medium",
      "outcomes": {"standard": "pass", "non_standard": "needs_verification", "unknown": "needs_verification"},
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_locator": "Rule 5; Second Schedule",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-VERSION-01",
      "rule_number": "Rule governance",
      "module": "R-VERSION",
      "title": "Effective date rule selection",
      "description": "Select rules based on inspection date and rule effective_from/effective_to.",
      "applicability": {"always": true},
      "validation_type": "system",
      "parameters": {},
      "severity": "info",
      "outcomes": {"selected": "pass"},
      "source_document": "Governance",
      "source_locator": "Rule governance",
      "version": "PCR-2026.1"
    },
    {
      "rule_id": "R-VERSION-02",
      "rule_number": "Governance",
      "module": "R-VERSION",
      "title": "Source traceability",
      "description": "Every automated legal finding must retain source notification/rule version.",
      "applicability": {"always": true},
      "validation_type": "system",
      "parameters": {},
      "severity": "info",
      "outcomes": {"traced": "pass"},
      "source_document": "Governance",
      "source_locator": "Evidence model; findings",
      "version": "PCR-2026.1"
    }
  ]
}